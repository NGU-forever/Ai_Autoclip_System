# ========================================
# AgentOS Enterprise - 环境变量配置模板
# ========================================

# --- 基础配置 ---
VITE_APP_NAME=AgentOS Enterprise
VITE_APP_VERSION=1.2.0
NODE_ENV=production

# --- API 配置 (Docker 内部通信) ---
VITE_API_URL=http://web:8000
VITE_API_BASE_URL=http://web:8000
VITE_API_TIMEOUT=30000

# --- 数据库配置 (PostgreSQL + pgvector) ---
POSTGRES_USER=agentos_user
POSTGRES_PASSWORD=agentos_password
POSTGRES_DB=agentos_db
# 外部连接地址
DATABASE_URL=postgresql://agentos_user:agentos_password@localhost:5432/agentos_db

# --- Redis 配置 ---
REDIS_URL=redis://redis:6379/0

# --- AI 模型核心配置 (LLM & Vision) ---
# LLM_PROVIDER: GLM 走 OpenAI 兼容协议，保持 openai
LLM_PROVIDER=openai
# LLM_MODEL: GLM 模型名（可改成 glm-4-plus / glm-4-air 等）
LLM_MODEL=glm-4-flash
# 对应 Provider 的 API Key（填写你的 GLM Key）
LLM_API_KEY=your-glm-api-key
# OpenAI 兼容基地址（GLM）
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ARK_API_KEY=你的火山引擎API_KEY
ARK_ENDPOINT_ID=你的推理终端ID(Endpoint_ID)

# --- ASR（真实转写） ---
# 你坚持全 GLM：ASR_PROVIDER 使用 glm
ASR_PROVIDER=glm
# GLM ASR 模型名
GLM_ASR_MODEL=glm-4.6

# --- 视频处理与存储 (可选) ---
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports

# --- 安全配置 ---
# JWT 密钥 (正式环境请务必修改)
SECRET_KEY=your-super-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- 后台工作流 (n8n) ---
N8N_ENCRYPTION_KEY=your-n8n-key
# 外部访问地址
N8N_BASE_URL=http://localhost:5678
