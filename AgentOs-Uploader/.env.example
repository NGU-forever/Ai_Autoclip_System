# ========================================
# AgentOS Uploader - 环境变量配置模板
# 用于本地独立启动 Uploader 服务
# ========================================

# --- 基础配置 ---
PROJECT_NAME=AgentOS Uploader Service
VERSION=1.0.0

# --- 服务配置 ---
# Uploader 服务端口
UPLOADER_PORT=8002
# 服务主机地址 (本地开发用 0.0.0.0，生产环境可指定)
UPLOADER_HOST=0.0.0.0

# --- 数据库配置 (PostgreSQL) ---
# 如果使用 Docker Compose 启动数据库，使用以下默认值：
# 独立部署时，请修改为实际的数据库地址
DATABASE_URL=postgresql://uploader:uploader@localhost:5432/uploader
# 数据库连接池配置
DB_POOL_MIN_CONN=5
DB_POOL_MAX_CONN=50

# --- Redis 配置 ---
# 如果使用 Docker Compose 启动 Redis，使用以下默认值：
# 独立部署时，请修改为实际的 Redis 地址
REDIS_URL=redis://localhost:6379/0

# --- 存储配置 ---
# 存储根目录 (本地开发建议使用相对路径，生产环境建议使用绝对路径)
STORAGE_ROOT=./storage
# 原始视频目录
RAW_DIR=raw
# 中间文件目录
INTERMEDIATE_DIR=intermediate
# 导出文件目录
EXPORTS_DIR=exports
# OpenStoryline 输出目录
OPENSTORYLINE_DIR=openstoryline

# --- Uploader 特定配置 ---
# Chrome/Chromium 浏览器路径 (留空使用 Playwright 自带的 Chromium)
UPLOADER_CHROME_PATH=
# 是否使用无头模式 (生产环境建议 true，本地开发建议 false 以便调试)
UPLOADER_HEADLESS=false
# Cookie 存储目录 (相对于 STORAGE_ROOT)
UPLOADER_COOKIES_DIR=uploader/cookies
# 视频上传临时目录 (相对于 STORAGE_ROOT)
UPLOADER_VIDEO_DIR=uploader/videos

# --- 浏览器会话配置 ---
# 浏览器心跳超时 (秒)
BROWSER_HEARTBEAT_TIMEOUT=300
# 心跳检查间隔 (秒)
BROWSER_HEARTBEAT_CHECK_INTERVAL=10
# 二维码默认有效期 (秒)
BROWSER_QR_VALIDITY=300
# 二维码等待超时 (秒)
BROWSER_QR_WAIT_TIMEOUT=60
# 刷新二维码等待超时 (秒)
BROWSER_REFRESH_QR_WAIT_TIMEOUT=30
# 登录轮询最大时间 (秒)
BROWSER_LOGIN_POLL_MAX_TIME=300
# 最大并发浏览器会话数
BROWSER_MAX_CONCURRENT_SESSIONS=10

# --- 平台特定的二维码有效期 (秒) ---
# 抖音约 3 分钟
PLATFORM_QR_VALIDITY_DOUYIN=180
# 视频号约 5 分钟
PLATFORM_QR_VALIDITY_TENCENT=300
# 小红书约 5 分钟
PLATFORM_QR_VALIDITY_XHS=300

# --- 外部服务配置 ---
# OpenStoryline 对外访问地址 (用于生成前端访问链接)
OPENSTORYLINE_PUBLIC_URL=http://localhost:7860
# OpenStoryline 内部访问地址 (Docker 内网访问)
OPENSTORYLINE_INTERNAL_URL=http://localhost:7860

# --- 日志配置 ---
# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ========================================
# 注意：JWT 认证配置已移除
# 认证统一由 backend 服务处理
# ========================================
