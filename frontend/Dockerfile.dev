# ========================================
# AgentOS Enterprise - Development Dockerfile
# ========================================

FROM node:20-alpine

WORKDIR /app

# 安装 pnpm
RUN npm install -g pnpm

# 复制 package 文件
COPY package*.json ./

# 安装依赖
RUN pnpm install

# 复制源代码
COPY . .

# 暴露端口
EXPOSE 5173 5174

# 启动开发服务器
CMD ["pnpm", "dev", "--host"]
